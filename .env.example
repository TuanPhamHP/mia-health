# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.
# Trên Cloudflare Pages: set bằng `wrangler pages secret put <TÊN>` hoặc Dashboard → Pages → Settings → Variables and Secrets.

# 32+ ký tự ngẫu nhiên — dùng để ký + mã hoá cookie session (nuxt-auth-utils đọc tự động).
# Sinh nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=replace-with-32-plus-random-chars-replace

# Password user nhập ở trang /login. Đặt password mạnh ở production.
NUXT_AUTH_PASSWORD=replace-with-your-password
